{#- One install target per development tool, installing it only when missing. #}
{% macro go_install(name, var, pkg, version) %}

.PHONY: install-{{ name }}
install-{{ name }}:
	@command -v $({{ var }}) >/dev/null || { \
		echo "warning: {{ name }} not found, installing {{ pkg }}@{{ version }} system-wide with go install" >&2 && \
		go install {{ pkg }}@{{ version }}; \
	}
{%- endmacro %}
{% set go_test = "$(GOTESTSUM) --" if gotestsum else "go test" %}
.DEFAULT_GOAL := help

# The variables in .env are exported to every recipe.
-include .env
export $(shell sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' .env 2>/dev/null)

# Missing development tools are installed system-wide with `go install`.
GOBIN_DIR := $(or $(shell go env GOBIN),$(shell go env GOPATH)/bin)
# A tool on PATH wins, otherwise it is used from where `go install` puts it.
tool = $(or $(shell command -v $(1) 2>/dev/null),$(GOBIN_DIR)/$(1))
AIR := $(call tool,air)
GOLANGCI_LINT := $(call tool,golangci-lint)
GOVULNCHECK := $(call tool,govulncheck)
TEMPL := $(call tool,templ)
TAILWINDCSS := $(call tool,tailwindcss)
{% if sqlc %}
SQLC := $(call tool,sqlc)
{% endif %}
{% if goose %}
GOOSE := $(call tool,goose)
{% endif %}
{% if gotestsum %}
GOTESTSUM := $(call tool,gotestsum)
{% endif %}

AIR_VERSION := {{ air_version }}
GOLANGCI_LINT_VERSION := {{ golangci_lint_version }}
GOVULNCHECK_VERSION := {{ govulncheck_version }}
{% if tailwind_cli %}
TAILWIND_VERSION := {{ tailwind_version }}
{% endif %}
{% if sqlc %}
SQLC_VERSION := {{ sqlc_version }}
{% endif %}
{% if goose %}
GOOSE_VERSION := {{ goose_version }}
{% endif %}
{% if gotestsum %}
GOTESTSUM_VERSION := {{ gotestsum_version }}
{% endif %}

.PHONY: all
all: build test ## Build and test the application

.PHONY: build
build:{% if generate %} generate{% endif %} ## Build the application
	go build -o main ./cmd/api

.PHONY: run
run:{% if generate %} generate{% endif %}{% if react %} install-frontend{% endif %} ## Run the application
{% if react %}
	trap 'kill 0' EXIT; go run ./cmd/api & npm run dev --prefix frontend
{% else %}
	go run ./cmd/api
{% endif %}
{% if generate %}

.PHONY: generate
generate:{% if templ %} install-templ{% endif %}{% if tailwind_cli %} install-tailwind{% endif %} ## Generate {% if templ %}templ{% endif %}{% if templ and tailwind_cli %} and {% endif %}{% if tailwind_cli %}tailwind{% endif %} files
{% if templ %}
	$(TEMPL) generate
{% endif %}
{% if tailwind_cli %}
	$(TAILWINDCSS) -i web/styles/input.css -o web/assets/css/output.css
{% endif %}
{% endif %}

.PHONY: test
test:{% if generate %} generate{% endif %}{% if gotestsum %} install-gotestsum{% endif %} ## Test the application
	{{ go_test }} ./...
{% if gotestsum %}

.PHONY: test-watch
test-watch:{% if generate %} generate{% endif %} install-gotestsum ## Rerun the tests of changed packages
	$(GOTESTSUM) --watch
{% endif %}
{% if external_db %}

.PHONY: itest
itest:{% if gotestsum %} install-gotestsum{% endif %} ## Run the database integration tests (requires Docker)
	{{ go_test }} -tags integration ./database
{% endif %}
{% if sqlc %}

.PHONY: sqlc
sqlc: install-sqlc ## Generate Go code from the SQL queries
	$(SQLC) generate
{% endif %}
{% if goose %}

.PHONY: migrate-up
migrate-up: install-goose ## Apply all pending migrations
	$(GOOSE) up

.PHONY: migrate-down
migrate-down: install-goose ## Roll back the latest migration
	$(GOOSE) down

.PHONY: migrate-status
migrate-status: install-goose ## Show the migration status
	$(GOOSE) status

.PHONY: migrate-new
migrate-new: install-goose ## Create a migration, e.g. make migrate-new name=add_email
	$(GOOSE) -s create $(name) sql
{% endif %}

.PHONY: lint
lint:{% if generate %} generate{% endif %} install-golangci-lint ## Lint the application
	$(GOLANGCI_LINT) run

.PHONY: fmt
fmt: install-golangci-lint ## Format the code with the formatters in .golangci.yml
	$(GOLANGCI_LINT) fmt

.PHONY: vuln
vuln:{% if generate %} generate{% endif %} install-govulncheck ## Check for known vulnerabilities
	$(GOVULNCHECK) ./...

.PHONY: clean
clean: ## Clean the binary
	rm -f main
{% if database == "sqlite" %}
	rm -f {{ project_name }}.db
{% endif %}

.PHONY: watch
watch: install-air ## Live Reload
	$(AIR)
{% if compose %}

.PHONY: docker-run
docker-run: ## Start the docker compose services
	docker compose up --build

.PHONY: docker-down
docker-down: ## Stop the docker compose services
	docker compose down
{% endif %}

.PHONY: help
help: ## Show this help
	@echo "Usage: make [target]"
	@echo
	@echo "Targets:"
	@awk 'BEGIN { FS = ":.*## " } /^[a-zA-Z0-9_-]+:.*## / { printf "  \033[36m%-14s\033[0m %s\n", $$1, $$2 }' $(MAKEFILE_LIST)
{{ go_install("air", "AIR", "github.com/air-verse/air", "$(AIR_VERSION)") }}
{{ go_install("golangci-lint", "GOLANGCI_LINT", "github.com/golangci/golangci-lint/v2/cmd/golangci-lint", "$(GOLANGCI_LINT_VERSION)") }}
{{ go_install("govulncheck", "GOVULNCHECK", "golang.org/x/vuln/cmd/govulncheck", "$(GOVULNCHECK_VERSION)") }}
{% if templ %}
{{ go_install("templ", "TEMPL", "github.com/a-h/templ/cmd/templ", "$$(go list -m github.com/a-h/templ | cut -d' ' -f2)") }}
{% endif %}
{% if sqlc %}
{{ go_install("sqlc", "SQLC", "github.com/sqlc-dev/sqlc/cmd/sqlc", "$(SQLC_VERSION)") }}
{% endif %}
{% if goose %}
{{ go_install("goose", "GOOSE", "github.com/pressly/goose/v3/cmd/goose", "$(GOOSE_VERSION)") }}
{% endif %}
{% if gotestsum %}
{{ go_install("gotestsum", "GOTESTSUM", "gotest.tools/gotestsum", "$(GOTESTSUM_VERSION)") }}
{% endif %}
{% if tailwind_cli %}

.PHONY: install-tailwind
install-tailwind:
	@command -v $(TAILWINDCSS) >/dev/null || { \
		echo "warning: tailwindcss not found, downloading $(TAILWIND_VERSION) system-wide into $(GOBIN_DIR)" >&2 && \
		mkdir -p $(GOBIN_DIR) && \
		os=$$(uname -s | tr '[:upper:]' '[:lower:]' | sed 's/darwin/macos/') && \
		arch=$$(uname -m | sed -e 's/x86_64/x64/' -e 's/aarch64/arm64/') && \
		curl -sSfL -o $(TAILWINDCSS) https://github.com/tailwindlabs/tailwindcss/releases/download/$(TAILWIND_VERSION)/tailwindcss-$$os-$$arch && \
		chmod +x $(TAILWINDCSS); \
	}
{% endif %}
{% if react %}

.PHONY: install-frontend
install-frontend:
	@test -d frontend/node_modules || npm install --prefix frontend
{% endif %}
