package server

import (
	"encoding/json"
	"log"
	"net/http"
{% if web %}

	"{{ module_path }}/web"
{% endif %}
)

func (s *Server) RegisterRoutes() http.Handler {
	mux := http.NewServeMux()

	mux.HandleFunc("GET /{$}", s.HelloWorldHandler)
{% if has_db %}
	mux.HandleFunc("GET /health", s.healthHandler)
{% endif %}
{% if websocket %}
	mux.HandleFunc("GET /websocket", s.websocketHandler)
{% endif %}
{% if web %}

{% if web_assets %}
	mux.Handle("GET /assets/", http.FileServer(http.FS(web.Files)))
{% endif %}
	mux.HandleFunc("GET /web", web.HelloFormHandler)
	mux.HandleFunc("POST /hello", web.HelloWebHandler)
{% endif %}

	return corsMiddleware(mux)
}
