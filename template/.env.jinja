PORT=8080
{% if database == "sqlite" %}
DB_URL=./{{ project_name }}.db
{% elif database == "postgres" %}
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE={{ project_name }}
DB_USERNAME={{ project_name }}
DB_PASSWORD=password
DB_SCHEMA=public
{% elif database == "mysql" %}
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE={{ project_name }}
DB_USERNAME={{ project_name }}
DB_PASSWORD=password
DB_ROOT_PASSWORD=rootpassword
{% elif database == "mongo" %}
DB_HOST=localhost
DB_PORT=27017
DB_USERNAME={{ project_name }}
DB_ROOT_PASSWORD=password
{% elif database == "redis" %}
DB_ADDRESS=localhost
DB_PORT=6379
DB_PASSWORD=
DB_DATABASE=0
{% elif database == "scylla" %}
DB_HOSTS=localhost:9042
DB_USERNAME=
DB_PASSWORD=
DB_CONSISTENCY=LOCAL_QUORUM
{% endif %}
{% if goose %}
GOOSE_DRIVER={{ goose_driver }}
{% if database == "sqlite" %}
GOOSE_DBSTRING=${DB_URL}
{% elif database == "postgres" %}
GOOSE_DBSTRING=postgres://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}?sslmode=disable&search_path=${DB_SCHEMA}
{% elif database == "mysql" %}
GOOSE_DBSTRING=${DB_USERNAME}:${DB_PASSWORD}@tcp(${DB_HOST}:${DB_PORT})/${DB_DATABASE}?parseTime=true
{% endif %}
GOOSE_MIGRATION_DIR=database/migrations
{% endif %}
