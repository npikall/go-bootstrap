name: Go-test

on:
  push:
    branches: [main]
  pull_request:

permissions: {}

concurrency:
{% raw %}
  group: ${{ github.workflow }}-${{ github.ref }}
{% endraw %}
  cancel-in-progress: true

jobs:
  test:
    name: Test and Build
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: go.mod
{% if templ %}
      - name: Generate templ files
        run: go run "github.com/a-h/templ/cmd/templ@$(go list -m github.com/a-h/templ | cut -d' ' -f2)" generate
{% endif %}
      - name: Build
        run: go build ./...
      - name: Test
{% if gotestsum %}
        run: go run gotest.tools/gotestsum@{{ gotestsum_version }} --format github-actions -- ./...
{% else %}
        run: go test ./...
{% endif %}

  lint:
    name: Lint
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: go.mod
{% if templ %}
      - name: Generate templ files
        run: go run "github.com/a-h/templ/cmd/templ@$(go list -m github.com/a-h/templ | cut -d' ' -f2)" generate
{% endif %}
      - uses: golangci/golangci-lint-action@ba0d7d2ec06a0ea1cb5fa41b2e4a3ab91d21278a # v9.3.0
        with:
          version: {{ golangci_lint_version }}
{% if external_db %}

  integration:
    name: Integration Tests
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: go.mod
      - name: Run integration tests
{% if gotestsum %}
        run: go run gotest.tools/gotestsum@{{ gotestsum_version }} --format github-actions -- -tags integration ./database
{% else %}
        run: go test -tags integration ./database
{% endif %}
{% endif %}
