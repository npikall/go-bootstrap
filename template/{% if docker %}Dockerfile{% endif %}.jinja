FROM golang:{{ go_version }}-alpine AS build
{% if tailwind_cli %}
RUN apk add --no-cache libstdc++ libgcc
{% endif %}
WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
{% if templ %}
RUN go run "github.com/a-h/templ/cmd/templ@$(go list -m github.com/a-h/templ | cut -d' ' -f2)" generate
{% endif %}
{% if tailwind_cli %}
ARG TARGETARCH
RUN wget -qO /usr/local/bin/tailwindcss "https://github.com/tailwindlabs/tailwindcss/releases/download/{{ tailwind_version }}/tailwindcss-linux-$(echo "${TARGETARCH:-amd64}" | sed 's/amd64/x64/')-musl" \
    && chmod +x /usr/local/bin/tailwindcss \
    && tailwindcss -i web/styles/input.css -o web/assets/css/output.css --minify
{% endif %}
RUN CGO_ENABLED=0 go build -o main ./cmd/api

FROM alpine:3.22 AS prod
WORKDIR /app
COPY --from=build /app/main /app/main
EXPOSE 8080
CMD ["./main"]
{% if react %}

FROM node:22-alpine AS frontend_build
WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ .
RUN npm run build

FROM node:22-alpine AS frontend
RUN npm install -g serve
COPY --from=frontend_build /frontend/dist /app/dist
EXPOSE 5173
CMD ["serve", "-s", "/app/dist", "-l", "5173"]
{% endif %}
