# Missing development tools are installed system-wide with `go install`.
gobin := `d=$(go env GOBIN); echo "${d:-$(go env GOPATH)/bin}"`
export PATH := gobin + ":" + env("PATH")
export AIR_VERSION := "{{ air_version }}"
export GOLANGCI_LINT_VERSION := "{{ golangci_lint_version }}"
{% if tailwind_cli %}
export TAILWIND_VERSION := "{{ tailwind_version }}"
{% endif %}

[private]
default:
    @just --list

# Build and test the application
all: build test

# Build the application
build:{% if templ %} generate{% endif %}

    go build -o main ./cmd/api

# Run the application
run:{% if templ %} generate{% endif %}{% if react %} install-frontend{% endif %}

{% if react %}
    trap 'kill 0' EXIT; go run ./cmd/api & npm run dev --prefix frontend
{% else %}
    go run ./cmd/api
{% endif %}
{% if templ %}

# Generate templ{% if tailwind_cli %} and tailwind{% endif %} files
generate: install-templ{% if tailwind_cli %} install-tailwind{% endif %}

    templ generate
{% if tailwind_cli %}
    tailwindcss -i web/styles/input.css -o web/assets/css/output.css
{% endif %}
{% endif %}

# Test the application
test:{% if templ %} generate{% endif %}

    go test ./...
{% if external_db %}

# Run the database integration tests (requires Docker)
itest:
    go test -tags integration ./database
{% endif %}

# Lint the application
lint:{% if templ %} generate{% endif %} install-golangci-lint
    golangci-lint run

# Clean the binary
clean:
    rm -f main
{% if database == "sqlite" %}
    rm -f {{ project_name }}.db
{% endif %}

# Live Reload
watch: install-air
    air
{% if compose %}

# Start the docker compose services
docker-run:
    docker compose up --build

# Stop the docker compose services
docker-down:
    docker compose down
{% endif %}

[private]
install-air:
    #!/bin/sh
    set -eu
    command -v air >/dev/null && exit 0
    echo "warning: air not found, installing github.com/air-verse/air@$AIR_VERSION system-wide with go install" >&2
    go install "github.com/air-verse/air@$AIR_VERSION"

[private]
install-golangci-lint:
    #!/bin/sh
    set -eu
    command -v golangci-lint >/dev/null && exit 0
    echo "warning: golangci-lint not found, installing github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$GOLANGCI_LINT_VERSION system-wide with go install" >&2
    go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$GOLANGCI_LINT_VERSION"
{% if templ %}

[private]
install-templ:
    #!/bin/sh
    set -eu
    command -v templ >/dev/null && exit 0
    echo "warning: templ not found, installing github.com/a-h/templ/cmd/templ@$(go list -m github.com/a-h/templ | cut -d' ' -f2) system-wide with go install" >&2
    go install "github.com/a-h/templ/cmd/templ@$(go list -m github.com/a-h/templ | cut -d' ' -f2)"
{% endif %}
{% if tailwind_cli %}

[private]
install-tailwind:
    #!/bin/sh
    set -eu
    command -v tailwindcss >/dev/null && exit 0
    echo "warning: tailwindcss not found, downloading $TAILWIND_VERSION system-wide into {% raw %}{{ gobin }}{% endraw %}" >&2
    mkdir -p "{% raw %}{{ gobin }}{% endraw %}"
    os=$(uname -s | tr '[:upper:]' '[:lower:]' | sed 's/darwin/macos/')
    arch=$(uname -m | sed -e 's/x86_64/x64/' -e 's/aarch64/arm64/')
    curl -sSfL -o "{% raw %}{{ gobin }}{% endraw %}/tailwindcss" "https://github.com/tailwindlabs/tailwindcss/releases/download/$TAILWIND_VERSION/tailwindcss-$os-$arch"
    chmod +x "{% raw %}{{ gobin }}{% endraw %}/tailwindcss"
{% endif %}
{% if react %}

[private]
install-frontend:
    @test -d frontend/node_modules || npm install --prefix frontend
{% endif %}
