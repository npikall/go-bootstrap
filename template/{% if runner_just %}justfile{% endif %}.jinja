export GOBIN := justfile_directory() / "bin"
export AIR_VERSION := "{{ air_version }}"
export GOLANGCI_LINT_VERSION := "{{ golangci_lint_version }}"
{% if tailwind_cli %}
export TAILWIND_VERSION := "{{ tailwind_version }}"
{% endif %}

[private]
default:
    @just --list

# Build and test the application
all: build test

# Build the application
build:{% if templ %} generate{% endif %}

    go build -o main ./cmd/api

# Run the application
run:{% if templ %} generate{% endif %}{% if react %} install-frontend{% endif %}

{% if react %}
    trap 'kill 0' EXIT; go run ./cmd/api & npm run dev --prefix frontend
{% else %}
    go run ./cmd/api
{% endif %}
{% if templ %}

# Generate templ{% if tailwind_cli %} and tailwind{% endif %} files
generate: install-templ{% if tailwind_cli %} install-tailwind{% endif %}

    "$GOBIN/templ" generate
{% if tailwind_cli %}
    "$GOBIN/tailwindcss" -i web/styles/input.css -o web/assets/css/output.css
{% endif %}
{% endif %}

# Test the application
test:{% if templ %} generate{% endif %}

    go test ./...
{% if external_db %}

# Run the database integration tests (requires Docker)
itest:
    go test -tags integration ./database
{% endif %}

# Lint the application
lint:{% if templ %} generate{% endif %} install-golangci-lint
    "$GOBIN/golangci-lint" run

# Clean the binary
clean:
    rm -f main
{% if database == "sqlite" %}
    rm -f {{ project_name }}.db
{% endif %}

# Live Reload
watch: install-air
    "$GOBIN/air"
{% if compose %}

# Start the docker compose services
docker-run:
    docker compose up --build

# Stop the docker compose services
docker-down:
    docker compose down
{% endif %}

[private]
install-air:
    @test -x "$GOBIN/air" || go install "github.com/air-verse/air@$AIR_VERSION"

[private]
install-golangci-lint:
    @test -x "$GOBIN/golangci-lint" || go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$GOLANGCI_LINT_VERSION"
{% if templ %}

[private]
install-templ:
    @test -x "$GOBIN/templ" || go install "github.com/a-h/templ/cmd/templ@$(go list -m github.com/a-h/templ | cut -d' ' -f2)"
{% endif %}
{% if tailwind_cli %}

[private]
install-tailwind:
    #!/bin/sh
    set -eu
    test -x "$GOBIN/tailwindcss" && exit 0
    mkdir -p "$GOBIN"
    os=$(uname -s | tr '[:upper:]' '[:lower:]' | sed 's/darwin/macos/')
    arch=$(uname -m | sed -e 's/x86_64/x64/' -e 's/aarch64/arm64/')
    curl -sSfL -o "$GOBIN/tailwindcss" "https://github.com/tailwindlabs/tailwindcss/releases/download/$TAILWIND_VERSION/tailwindcss-$os-$arch"
    chmod +x "$GOBIN/tailwindcss"
{% endif %}
{% if react %}

[private]
install-frontend:
    @test -d frontend/node_modules || npm install --prefix frontend
{% endif %}
