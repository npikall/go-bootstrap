{#- One install target per development tool, installing it only when missing. #}
{% macro go_install(name, pkg, version) %}

[private]
install-{{ name }}:
    #!/bin/sh
    set -eu
    command -v {{ name }} >/dev/null && exit 0
    echo "warning: {{ name }} not found, installing {{ pkg }}@{{ version }} system-wide with go install" >&2
    go install "{{ pkg }}@{{ version }}"
{%- endmacro %}
{% set go_test = "gotestsum --" if gotestsum else "go test" %}
# The variables in .env are exported to every recipe.
set dotenv-load

# Missing development tools are installed system-wide with `go install`.
gobin := `d=$(go env GOBIN); echo "${d:-$(go env GOPATH)/bin}"`
export PATH := gobin + ":" + env("PATH")
export AIR_VERSION := "{{ air_version }}"
export GOLANGCI_LINT_VERSION := "{{ golangci_lint_version }}"
export GOVULNCHECK_VERSION := "{{ govulncheck_version }}"
{% if tailwind_cli %}
export TAILWIND_VERSION := "{{ tailwind_version }}"
{% endif %}
{% if sqlc %}
export SQLC_VERSION := "{{ sqlc_version }}"
{% endif %}
{% if goose %}
export GOOSE_VERSION := "{{ goose_version }}"
{% endif %}
{% if gotestsum %}
export GOTESTSUM_VERSION := "{{ gotestsum_version }}"
{% endif %}

[private]
default:
    @just --list

# Build and test the application
all: build test

# Build the application
build:{% if templ %} generate{% endif %}

    go build -o main ./cmd/api

# Run the application
run:{% if templ %} generate{% endif %}{% if react %} install-frontend{% endif %}

{% if react %}
    trap 'kill 0' EXIT; go run ./cmd/api & npm run dev --prefix frontend
{% else %}
    go run ./cmd/api
{% endif %}
{% if templ %}

# Generate templ{% if tailwind_cli %} and tailwind{% endif %} files
generate: install-templ{% if tailwind_cli %} install-tailwind{% endif %}

    templ generate
{% if tailwind_cli %}
    tailwindcss -i web/styles/input.css -o web/assets/css/output.css
{% endif %}
{% endif %}

# Test the application
test:{% if templ %} generate{% endif %}{% if gotestsum %} install-gotestsum{% endif %}

    {{ go_test }} ./...
{% if gotestsum %}

# Rerun the tests of changed packages
test-watch:{% if templ %} generate{% endif %} install-gotestsum
    gotestsum --watch
{% endif %}
{% if external_db %}

# Run the database integration tests (requires Docker)
itest:{% if gotestsum %} install-gotestsum{% endif %}

    {{ go_test }} -tags integration ./database
{% endif %}
{% if sqlc %}

# Generate Go code from the SQL queries
sqlc: install-sqlc
    sqlc generate
{% endif %}
{% if goose %}

# Apply all pending migrations
migrate-up: install-goose
    goose up

# Roll back the latest migration
migrate-down: install-goose
    goose down

# Show the migration status
migrate-status: install-goose
    goose status

# Create a migration, e.g. just migrate-new add_email
migrate-new name: install-goose
    goose -s create {% raw %}{{ name }}{% endraw %} sql
{% endif %}

# Lint the application
lint:{% if templ %} generate{% endif %} install-golangci-lint
    golangci-lint run

# Check for known vulnerabilities
vuln:{% if templ %} generate{% endif %} install-govulncheck
    govulncheck ./...

# Clean the binary
clean:
    rm -f main
{% if database == "sqlite" %}
    rm -f {{ project_name }}.db
{% endif %}

# Live Reload
watch: install-air
    air
{% if compose %}

# Start the docker compose services
docker-run:
    docker compose up --build

# Stop the docker compose services
docker-down:
    docker compose down
{% endif %}
{{ go_install("air", "github.com/air-verse/air", "$AIR_VERSION") }}
{{ go_install("golangci-lint", "github.com/golangci/golangci-lint/v2/cmd/golangci-lint", "$GOLANGCI_LINT_VERSION") }}
{{ go_install("govulncheck", "golang.org/x/vuln/cmd/govulncheck", "$GOVULNCHECK_VERSION") }}
{% if templ %}
{{ go_install("templ", "github.com/a-h/templ/cmd/templ", "$(go list -m github.com/a-h/templ | cut -d' ' -f2)") }}
{% endif %}
{% if sqlc %}
{{ go_install("sqlc", "github.com/sqlc-dev/sqlc/cmd/sqlc", "$SQLC_VERSION") }}
{% endif %}
{% if goose %}
{{ go_install("goose", "github.com/pressly/goose/v3/cmd/goose", "$GOOSE_VERSION") }}
{% endif %}
{% if gotestsum %}
{{ go_install("gotestsum", "gotest.tools/gotestsum", "$GOTESTSUM_VERSION") }}
{% endif %}
{% if tailwind_cli %}

[private]
install-tailwind:
    #!/bin/sh
    set -eu
    command -v tailwindcss >/dev/null && exit 0
    echo "warning: tailwindcss not found, downloading $TAILWIND_VERSION system-wide into {% raw %}{{ gobin }}{% endraw %}" >&2
    mkdir -p "{% raw %}{{ gobin }}{% endraw %}"
    os=$(uname -s | tr '[:upper:]' '[:lower:]' | sed 's/darwin/macos/')
    arch=$(uname -m | sed -e 's/x86_64/x64/' -e 's/aarch64/arm64/')
    curl -sSfL -o "{% raw %}{{ gobin }}{% endraw %}/tailwindcss" "https://github.com/tailwindlabs/tailwindcss/releases/download/$TAILWIND_VERSION/tailwindcss-$os-$arch"
    chmod +x "{% raw %}{{ gobin }}{% endraw %}/tailwindcss"
{% endif %}
{% if react %}

[private]
install-frontend:
    @test -d frontend/node_modules || npm install --prefix frontend
{% endif %}
