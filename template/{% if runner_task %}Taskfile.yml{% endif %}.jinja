version: "3"

# Missing development tools are installed system-wide with `go install`.
vars:
  GOBIN_DIR:
    sh: d=$(go env GOBIN); echo "${d:-$(go env GOPATH)/bin}"
  # A tool on PATH wins, otherwise it is used from where `go install` puts it.
{% raw %}  AIR:
    sh: command -v air || echo "{{.GOBIN_DIR}}/air"
  GOLANGCI_LINT:
    sh: command -v golangci-lint || echo "{{.GOBIN_DIR}}/golangci-lint"
{% endraw %}{% if templ %}
{% raw %}  TEMPL:
    sh: command -v templ || echo "{{.GOBIN_DIR}}/templ"
{% endraw %}{% endif %}
{% if tailwind_cli %}
{% raw %}  TAILWINDCSS:
    sh: command -v tailwindcss || echo "{{.GOBIN_DIR}}/tailwindcss"
{% endraw %}{% endif %}

env:
  AIR_VERSION: {{ air_version }}
  GOLANGCI_LINT_VERSION: {{ golangci_lint_version }}
{% if tailwind_cli %}
  TAILWIND_VERSION: {{ tailwind_version }}
{% endif %}

tasks:
  default:
    cmds:
      - task --list
    silent: true

  all:
    desc: Build and test the application
    cmds:
      - task: build
      - task: test

  build:
    desc: Build the application
{% if templ %}
    deps: [generate]
{% endif %}
    cmds:
      - go build -o main ./cmd/api

  run:
    desc: Run the application
{% if react %}
    deps: [run-api, run-frontend]

  run-api:
    internal: true
{% if templ %}
    deps: [generate]
{% endif %}
    cmds:
      - go run ./cmd/api

  run-frontend:
    internal: true
    deps: [install-frontend]
    cmds:
      - npm run dev --prefix frontend
{% else %}
{% if templ %}
    deps: [generate]
{% endif %}
    cmds:
      - go run ./cmd/api
{% endif %}
{% if templ %}

  generate:
    desc: Generate templ{% if tailwind_cli %} and tailwind{% endif %} files
    deps: [install-templ{% if tailwind_cli %}, install-tailwind{% endif %}]
    cmds:
      - '"{{ '{{.TEMPL}}' }}" generate'
{% if tailwind_cli %}
      - '"{{ '{{.TAILWINDCSS}}' }}" -i web/styles/input.css -o web/assets/css/output.css'
{% endif %}
{% endif %}

  test:
    desc: Test the application
{% if templ %}
    deps: [generate]
{% endif %}
    cmds:
      - go test ./...
{% if external_db %}

  itest:
    desc: Run the database integration tests (requires Docker)
    cmds:
      - go test -tags integration ./database
{% endif %}

  lint:
    desc: Lint the application
    deps: [{% if templ %}generate, {% endif %}install-golangci-lint]
    cmds:
      - '"{{ '{{.GOLANGCI_LINT}}' }}" run'

  clean:
    desc: Clean the binary
    cmds:
      - rm -f main
{% if database == "sqlite" %}
      - rm -f {{ project_name }}.db
{% endif %}

  watch:
    desc: Live Reload
    deps: [install-air]
    cmds:
      - '"{{ '{{.AIR}}' }}"'
{% if compose %}

  docker-run:
    desc: Start the docker compose services
    cmds:
      - docker compose up --build

  docker-down:
    desc: Stop the docker compose services
    cmds:
      - docker compose down
{% endif %}

  install-air:
    internal: true
    status:
      - test -x "{{ '{{.AIR}}' }}"
    cmds:
      - silent: true
        cmd: >-
          echo "warning: air not found, installing github.com/air-verse/air@$AIR_VERSION system-wide with go install" >&2
      - go install "github.com/air-verse/air@$AIR_VERSION"

  install-golangci-lint:
    internal: true
    status:
      - test -x "{{ '{{.GOLANGCI_LINT}}' }}"
    cmds:
      - silent: true
        cmd: >-
          echo "warning: golangci-lint not found, installing github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$GOLANGCI_LINT_VERSION system-wide with go install" >&2
      - go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$GOLANGCI_LINT_VERSION"
{% if templ %}

  install-templ:
    internal: true
    status:
      - test -x "{{ '{{.TEMPL}}' }}"
    cmds:
      - silent: true
        cmd: >-
          echo "warning: templ not found, installing github.com/a-h/templ/cmd/templ@$(go list -m github.com/a-h/templ | cut -d' ' -f2) system-wide with go install" >&2
      - go install "github.com/a-h/templ/cmd/templ@$(go list -m github.com/a-h/templ | cut -d' ' -f2)"
{% endif %}
{% if tailwind_cli %}

  install-tailwind:
    internal: true
    status:
      - test -x "{{ '{{.TAILWINDCSS}}' }}"
    cmds:
      - silent: true
        cmd: >-
          echo "warning: tailwindcss not found, downloading $TAILWIND_VERSION system-wide into {{ '{{.GOBIN_DIR}}' }}" >&2
      - mkdir -p "{{ '{{.GOBIN_DIR}}' }}"
      - >-
        curl -sSfL -o "{{ '{{.TAILWINDCSS}}' }}"
        "https://github.com/tailwindlabs/tailwindcss/releases/download/$TAILWIND_VERSION/tailwindcss-$(uname -s | tr '[:upper:]' '[:lower:]' | sed 's/darwin/macos/')-$(uname -m | sed -e 's/x86_64/x64/' -e 's/aarch64/arm64/')"
      - chmod +x "{{ '{{.TAILWINDCSS}}' }}"
{% endif %}
{% if react %}

  install-frontend:
    internal: true
    status:
      - test -d frontend/node_modules
    cmds:
      - npm install --prefix frontend
{% endif %}
