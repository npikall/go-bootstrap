version: "3"

env:
  AIR_VERSION: {{ air_version }}
  GOLANGCI_LINT_VERSION: {{ golangci_lint_version }}
{% if tailwind_cli %}
  TAILWIND_VERSION: {{ tailwind_version }}
{% endif %}

tasks:
  default:
    cmds:
      - task --list
    silent: true

  all:
    desc: Build and test the application
    cmds:
      - task: build
      - task: test

  build:
    desc: Build the application
{% if templ %}
    deps: [generate]
{% endif %}
    cmds:
      - go build -o main ./cmd/api

  run:
    desc: Run the application
{% if react %}
    deps: [run-api, run-frontend]

  run-api:
    internal: true
{% if templ %}
    deps: [generate]
{% endif %}
    cmds:
      - go run ./cmd/api

  run-frontend:
    internal: true
    deps: [install-frontend]
    cmds:
      - npm run dev --prefix frontend
{% else %}
{% if templ %}
    deps: [generate]
{% endif %}
    cmds:
      - go run ./cmd/api
{% endif %}
{% if templ %}

  generate:
    desc: Generate templ{% if tailwind_cli %} and tailwind{% endif %} files
    deps: [install-templ{% if tailwind_cli %}, install-tailwind{% endif %}]
    cmds:
      - ./bin/templ generate
{% if tailwind_cli %}
      - ./bin/tailwindcss -i web/styles/input.css -o web/assets/css/output.css
{% endif %}
{% endif %}

  test:
    desc: Test the application
{% if templ %}
    deps: [generate]
{% endif %}
    cmds:
      - go test ./...
{% if external_db %}

  itest:
    desc: Run the database integration tests (requires Docker)
    cmds:
      - go test -tags integration ./database
{% endif %}

  lint:
    desc: Lint the application
    deps: [{% if templ %}generate, {% endif %}install-golangci-lint]
    cmds:
      - ./bin/golangci-lint run

  clean:
    desc: Clean the binary
    cmds:
      - rm -f main
{% if database == "sqlite" %}
      - rm -f {{ project_name }}.db
{% endif %}

  watch:
    desc: Live Reload
    deps: [install-air]
    cmds:
      - ./bin/air
{% if compose %}

  docker-run:
    desc: Start the docker compose services
    cmds:
      - docker compose up --build

  docker-down:
    desc: Stop the docker compose services
    cmds:
      - docker compose down
{% endif %}

  install-air:
    internal: true
    status:
      - test -x bin/air
    cmds:
      - GOBIN="$PWD/bin" go install "github.com/air-verse/air@$AIR_VERSION"

  install-golangci-lint:
    internal: true
    status:
      - test -x bin/golangci-lint
    cmds:
      - GOBIN="$PWD/bin" go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$GOLANGCI_LINT_VERSION"
{% if templ %}

  install-templ:
    internal: true
    status:
      - test -x bin/templ
    cmds:
      - GOBIN="$PWD/bin" go install "github.com/a-h/templ/cmd/templ@$(go list -m github.com/a-h/templ | cut -d' ' -f2)"
{% endif %}
{% if tailwind_cli %}

  install-tailwind:
    internal: true
    status:
      - test -x bin/tailwindcss
    cmds:
      - mkdir -p bin
      - >-
        curl -sSfL -o bin/tailwindcss
        "https://github.com/tailwindlabs/tailwindcss/releases/download/$TAILWIND_VERSION/tailwindcss-$(uname -s | tr '[:upper:]' '[:lower:]' | sed 's/darwin/macos/')-$(uname -m | sed -e 's/x86_64/x64/' -e 's/aarch64/arm64/')"
      - chmod +x bin/tailwindcss
{% endif %}
{% if react %}

  install-frontend:
    internal: true
    status:
      - test -d frontend/node_modules
    cmds:
      - npm install --prefix frontend
{% endif %}
