{#- One install target per development tool, installing it only when missing. #}
{% macro go_install(name, var, pkg, version) %}

  install-{{ name }}:
    internal: true
    status:
      - test -x "{{ '{{.' ~ var ~ '}}' }}"
    cmds:
      - silent: true
        cmd: >-
          echo "warning: {{ name }} not found, installing {{ pkg }}@{{ version }} system-wide with go install" >&2
      - go install "{{ pkg }}@{{ version }}"
{%- endmacro %}
{% set go_test = '"{{.GOTESTSUM}}" --' if gotestsum else "go test" %}
version: "3"

# The variables in .env are exported to every task.
dotenv: [".env"]

# Missing development tools are installed system-wide with `go install`.
vars:
  GOBIN_DIR:
    sh: d=$(go env GOBIN); echo "${d:-$(go env GOPATH)/bin}"
  # A tool on PATH wins, otherwise it is used from where `go install` puts it.
{% raw %}  AIR:
    sh: command -v air || echo "{{.GOBIN_DIR}}/air"
  GOLANGCI_LINT:
    sh: command -v golangci-lint || echo "{{.GOBIN_DIR}}/golangci-lint"
  GOVULNCHECK:
    sh: command -v govulncheck || echo "{{.GOBIN_DIR}}/govulncheck"
{% endraw %}{% if templ %}
{% raw %}  TEMPL:
    sh: command -v templ || echo "{{.GOBIN_DIR}}/templ"
{% endraw %}{% endif %}
{% if tailwind_cli %}
{% raw %}  TAILWINDCSS:
    sh: command -v tailwindcss || echo "{{.GOBIN_DIR}}/tailwindcss"
{% endraw %}{% endif %}
{% if sqlc %}
{% raw %}  SQLC:
    sh: command -v sqlc || echo "{{.GOBIN_DIR}}/sqlc"
{% endraw %}{% endif %}
{% if goose %}
{% raw %}  GOOSE:
    sh: command -v goose || echo "{{.GOBIN_DIR}}/goose"
{% endraw %}{% endif %}
{% if gotestsum %}
{% raw %}  GOTESTSUM:
    sh: command -v gotestsum || echo "{{.GOBIN_DIR}}/gotestsum"
{% endraw %}{% endif %}

env:
  AIR_VERSION: {{ air_version }}
  GOLANGCI_LINT_VERSION: {{ golangci_lint_version }}
  GOVULNCHECK_VERSION: {{ govulncheck_version }}
{% if tailwind_cli %}
  TAILWIND_VERSION: {{ tailwind_version }}
{% endif %}
{% if sqlc %}
  SQLC_VERSION: {{ sqlc_version }}
{% endif %}
{% if goose %}
  GOOSE_VERSION: {{ goose_version }}
{% endif %}
{% if gotestsum %}
  GOTESTSUM_VERSION: {{ gotestsum_version }}
{% endif %}

tasks:
  default:
    cmds:
      - task --list
    silent: true

  all:
    desc: Build and test the application
    cmds:
      - task: build
      - task: test

  build:
    desc: Build the application
{% if generate %}
    deps: [generate]
{% endif %}
    cmds:
      - go build -o main ./cmd/api

  run:
    desc: Run the application
{% if react %}
    deps: [run-api, run-frontend]

  run-api:
    internal: true
{% if generate %}
    deps: [generate]
{% endif %}
    cmds:
      - go run ./cmd/api

  run-frontend:
    internal: true
    deps: [install-frontend]
    cmds:
      - npm run dev --prefix frontend
{% else %}
{% if generate %}
    deps: [generate]
{% endif %}
    cmds:
      - go run ./cmd/api
{% endif %}
{% if generate %}

  generate:
    desc: Generate {% if templ %}templ{% endif %}{% if templ and tailwind_cli %} and {% endif %}{% if tailwind_cli %}tailwind{% endif %} files
    deps: [{% if templ %}install-templ{% endif %}{% if templ and tailwind_cli %}, {% endif %}{% if tailwind_cli %}install-tailwind{% endif %}]
    cmds:
{% if templ %}
      - '"{{ '{{.TEMPL}}' }}" generate'
{% endif %}
{% if tailwind_cli %}
      - '"{{ '{{.TAILWINDCSS}}' }}" -i web/styles/input.css -o web/assets/css/output.css'
{% endif %}
{% endif %}

  test:
    desc: Test the application
{% if generate or gotestsum %}
    deps: [{% if generate %}generate{% endif %}{% if generate and gotestsum %}, {% endif %}{% if gotestsum %}install-gotestsum{% endif %}]
{% endif %}
    cmds:
      - '{{ go_test }} ./...'
{% if gotestsum %}

  test-watch:
    desc: Rerun the tests of changed packages
    deps: [{% if generate %}generate, {% endif %}install-gotestsum]
    cmds:
      - '"{{ '{{.GOTESTSUM}}' }}" --watch'
{% endif %}
{% if external_db %}

  itest:
    desc: Run the database integration tests (requires Docker)
{% if gotestsum %}
    deps: [install-gotestsum]
{% endif %}
    cmds:
      - '{{ go_test }} -tags integration ./database'
{% endif %}
{% if sqlc %}

  sqlc:
    desc: Generate Go code from the SQL queries
    deps: [install-sqlc]
    cmds:
      - '"{{ '{{.SQLC}}' }}" generate'
{% endif %}
{% if goose %}

  migrate-up:
    desc: Apply all pending migrations
    deps: [install-goose]
    cmds:
      - '"{{ '{{.GOOSE}}' }}" up'

  migrate-down:
    desc: Roll back the latest migration
    deps: [install-goose]
    cmds:
      - '"{{ '{{.GOOSE}}' }}" down'

  migrate-status:
    desc: Show the migration status
    deps: [install-goose]
    cmds:
      - '"{{ '{{.GOOSE}}' }}" status'

  migrate-new:
    desc: Create a migration, e.g. task migrate-new -- add_email
    deps: [install-goose]
    requires:
      vars: [CLI_ARGS]
    cmds:
      - '"{{ '{{.GOOSE}}' }}" -s create {{ '{{.CLI_ARGS}}' }} sql'
{% endif %}

  lint:
    desc: Lint the application
    deps: [{% if generate %}generate, {% endif %}install-golangci-lint]
    cmds:
      - '"{{ '{{.GOLANGCI_LINT}}' }}" run'

  fmt:
    desc: Format the code with the formatters in .golangci.yml
    deps: [install-golangci-lint]
    cmds:
      - '"{{ '{{.GOLANGCI_LINT}}' }}" fmt'

  vuln:
    desc: Check for known vulnerabilities
    deps: [{% if generate %}generate, {% endif %}install-govulncheck]
    cmds:
      - '"{{ '{{.GOVULNCHECK}}' }}" ./...'

  clean:
    desc: Clean the binary
    cmds:
      - rm -f main
{% if database == "sqlite" %}
      - rm -f {{ project_name }}.db
{% endif %}

  watch:
    desc: Live Reload
    deps: [install-air]
    cmds:
      - '"{{ '{{.AIR}}' }}"'
{% if compose %}

  docker-run:
    desc: Start the docker compose services
    cmds:
      - docker compose up --build

  docker-down:
    desc: Stop the docker compose services
    cmds:
      - docker compose down
{% endif %}
{{ go_install("air", "AIR", "github.com/air-verse/air", "$AIR_VERSION") }}
{{ go_install("golangci-lint", "GOLANGCI_LINT", "github.com/golangci/golangci-lint/v2/cmd/golangci-lint", "$GOLANGCI_LINT_VERSION") }}
{{ go_install("govulncheck", "GOVULNCHECK", "golang.org/x/vuln/cmd/govulncheck", "$GOVULNCHECK_VERSION") }}
{% if templ %}
{{ go_install("templ", "TEMPL", "github.com/a-h/templ/cmd/templ", "$(go list -m github.com/a-h/templ | cut -d' ' -f2)") }}
{% endif %}
{% if sqlc %}
{{ go_install("sqlc", "SQLC", "github.com/sqlc-dev/sqlc/cmd/sqlc", "$SQLC_VERSION") }}
{% endif %}
{% if goose %}
{{ go_install("goose", "GOOSE", "github.com/pressly/goose/v3/cmd/goose", "$GOOSE_VERSION") }}
{% endif %}
{% if gotestsum %}
{{ go_install("gotestsum", "GOTESTSUM", "gotest.tools/gotestsum", "$GOTESTSUM_VERSION") }}
{% endif %}
{% if tailwind_cli %}

  install-tailwind:
    internal: true
    status:
      - test -x "{{ '{{.TAILWINDCSS}}' }}"
    cmds:
      - silent: true
        cmd: >-
          echo "warning: tailwindcss not found, downloading $TAILWIND_VERSION system-wide into {{ '{{.GOBIN_DIR}}' }}" >&2
      - mkdir -p "{{ '{{.GOBIN_DIR}}' }}"
      - >-
        curl -sSfL -o "{{ '{{.TAILWINDCSS}}' }}"
        "https://github.com/tailwindlabs/tailwindcss/releases/download/$TAILWIND_VERSION/tailwindcss-$(uname -s | tr '[:upper:]' '[:lower:]' | sed 's/darwin/macos/')-$(uname -m | sed -e 's/x86_64/x64/' -e 's/aarch64/arm64/')"
      - chmod +x "{{ '{{.TAILWINDCSS}}' }}"
{% endif %}
{% if react %}

  install-frontend:
    internal: true
    status:
      - test -d frontend/node_modules
    cmds:
      - npm install --prefix frontend
{% endif %}
