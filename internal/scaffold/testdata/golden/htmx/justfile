# The variables in .env are exported to every recipe.
set dotenv-load

# Missing development tools are installed system-wide with `go install`.
gobin := `d=$(go env GOBIN); echo "${d:-$(go env GOPATH)/bin}"`
export PATH := gobin + ":" + env("PATH")
export AIR_VERSION := "v1.67.4"
export GOLANGCI_LINT_VERSION := "v2.15.0"
export TAILWIND_VERSION := "v4.3.5"
export SQLC_VERSION := "v1.31.1"
export GOOSE_VERSION := "v3.30.1"
export GOTESTSUM_VERSION := "v1.13.0"

[private]
default:
    @just --list

# Build and test the application
all: build test

# Build the application
build: generate
    go build -o main ./cmd/api

# Run the application
run: generate
    go run ./cmd/api

# Generate templ and tailwind files
generate: install-templ install-tailwind
    templ generate
    tailwindcss -i web/styles/input.css -o web/assets/css/output.css

# Test the application
test: generate install-gotestsum
    gotestsum -- ./...

# Rerun the tests of changed packages
test-watch: generate install-gotestsum
    gotestsum --watch

# Run the database integration tests (requires Docker)
itest: install-gotestsum
    gotestsum -- -tags integration ./database

# Generate Go code from the SQL queries
sqlc: install-sqlc
    sqlc generate

# Apply all pending migrations
migrate-up: install-goose
    goose up

# Roll back the latest migration
migrate-down: install-goose
    goose down

# Show the migration status
migrate-status: install-goose
    goose status

# Create a migration, e.g. just migrate-new add_email
migrate-new name: install-goose
    goose -s create {{ name }} sql

# Lint the application
lint: generate install-golangci-lint
    golangci-lint run

# Clean the binary
clean:
    rm -f main

# Live Reload
watch: install-air
    air

# Start the docker compose services
docker-run:
    docker compose up --build

# Stop the docker compose services
docker-down:
    docker compose down

[private]
install-air:
    #!/bin/sh
    set -eu
    command -v air >/dev/null && exit 0
    echo "warning: air not found, installing github.com/air-verse/air@$AIR_VERSION system-wide with go install" >&2
    go install "github.com/air-verse/air@$AIR_VERSION"

[private]
install-golangci-lint:
    #!/bin/sh
    set -eu
    command -v golangci-lint >/dev/null && exit 0
    echo "warning: golangci-lint not found, installing github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$GOLANGCI_LINT_VERSION system-wide with go install" >&2
    go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@$GOLANGCI_LINT_VERSION"

[private]
install-templ:
    #!/bin/sh
    set -eu
    command -v templ >/dev/null && exit 0
    echo "warning: templ not found, installing github.com/a-h/templ/cmd/templ@$(go list -m github.com/a-h/templ | cut -d' ' -f2) system-wide with go install" >&2
    go install "github.com/a-h/templ/cmd/templ@$(go list -m github.com/a-h/templ | cut -d' ' -f2)"

[private]
install-sqlc:
    #!/bin/sh
    set -eu
    command -v sqlc >/dev/null && exit 0
    echo "warning: sqlc not found, installing github.com/sqlc-dev/sqlc/cmd/sqlc@$SQLC_VERSION system-wide with go install" >&2
    go install "github.com/sqlc-dev/sqlc/cmd/sqlc@$SQLC_VERSION"

[private]
install-goose:
    #!/bin/sh
    set -eu
    command -v goose >/dev/null && exit 0
    echo "warning: goose not found, installing github.com/pressly/goose/v3/cmd/goose@$GOOSE_VERSION system-wide with go install" >&2
    go install "github.com/pressly/goose/v3/cmd/goose@$GOOSE_VERSION"

[private]
install-gotestsum:
    #!/bin/sh
    set -eu
    command -v gotestsum >/dev/null && exit 0
    echo "warning: gotestsum not found, installing gotest.tools/gotestsum@$GOTESTSUM_VERSION system-wide with go install" >&2
    go install "gotest.tools/gotestsum@$GOTESTSUM_VERSION"

[private]
install-tailwind:
    #!/bin/sh
    set -eu
    command -v tailwindcss >/dev/null && exit 0
    echo "warning: tailwindcss not found, downloading $TAILWIND_VERSION system-wide into {{ gobin }}" >&2
    mkdir -p "{{ gobin }}"
    os=$(uname -s | tr '[:upper:]' '[:lower:]' | sed 's/darwin/macos/')
    arch=$(uname -m | sed -e 's/x86_64/x64/' -e 's/aarch64/arm64/')
    curl -sSfL -o "{{ gobin }}/tailwindcss" "https://github.com/tailwindlabs/tailwindcss/releases/download/$TAILWIND_VERSION/tailwindcss-$os-$arch"
    chmod +x "{{ gobin }}/tailwindcss"
