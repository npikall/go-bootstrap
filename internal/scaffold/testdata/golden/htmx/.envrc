PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=demo
DB_USERNAME=demo
DB_PASSWORD=password
DB_SCHEMA=public
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_DATABASE}?sslmode=disable&search_path=${DB_SCHEMA}
GOOSE_MIGRATION_DIR=database/migrations
